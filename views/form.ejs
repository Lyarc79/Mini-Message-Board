<html>
  <head>
    <title>Form</title>
  </head>
  <body>
    <h2>Create a New Message</h2>
    <form method="POST" action="/new">
      <label>Author:<input name="authorName" type="text" /></label>
      <label>Message:<input name="messageText" type="text" /></label>
      <button type="submit">Send</button>
    </form>
  </body>
</html>
