<html>
  <head>
    <title>Message Board</title>
  </head>
  <body>
    <h1>Message Board</h1>
    <ul>
        <% messages.forEach((message, index) => { %>
            <li>
                <strong><%= message.username %></strong>
                <p><%= message.text %></p>
                <em><%= message.added.toLocaleDateString('en-GB') %> at <%= message.added.toLocaleTimeString('en-GB', {hour: '2-digit', minute: '2-digit', hour12: false}).toLowerCase().replace(' ', '') %></em>
                <a href="/message/<%=message.id%>">Open</a>
            </li> 
            <br />
        <% })%>
    </ul>
    <a href="/new">New message</a>
  </body>
</html>
